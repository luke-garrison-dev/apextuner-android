    <string name="ui_apextuner_s_firewall_is_a_user_approved_local_vpn_sink" formatted="false">ApexTuner\'s firewall is a user-approved local VPN sink. It does not inspect payloads, provide a remote VPN, proxy traffic, or send network contents off-device. Unselected apps bypass the tunnel.</string>
