    <string name="dashboard_rec_thermal_critical_title">Reduce thermal load</string>
    <string name="dashboard_rec_thermal_critical_body">The system reports severe thermal pressure. Pause demanding work, remove charging if practical, and let the device cool before optimizing performance.</string>
    <string name="dashboard_rec_thermal_moderate_title">Thermal pressure detected</string>
    <string name="dashboard_rec_thermal_moderate_body">The device is throttling moderately. Avoid performance tuning until the thermal state returns to light or none.</string>
    <string name="dashboard_rec_storage_critical_title">Free internal storage</string>
    <string name="dashboard_rec_storage_critical_body">Internal free space is below 10%. Review large files and downloads before Android begins struggling with updates, caches, and temporary files.</string>
    <string name="dashboard_rec_storage_low_title">Storage is getting low</string>
    <string name="dashboard_rec_storage_low_body">Internal free space is below 15%. Review large or unused content soon; ApexTuner will never delete personal files without confirmation.</string>
    <string name="dashboard_rec_memory_low_title">Android reports low memory</string>
    <string name="dashboard_rec_memory_low_body">Memory pressure is high. Close an app you no longer need rather than force-stopping system services or repeatedly clearing RAM.</string>
    <string name="dashboard_rec_memory_high_title">Memory use is elevated</string>
    <string name="dashboard_rec_memory_high_body">RAM use is above 90%. This can still be normal on Android, which intentionally uses free RAM for caches; optimize only if the device is actually slowing down.</string>
    <string name="dashboard_rec_battery_warm_title">Battery is warm</string>
    <string name="dashboard_rec_battery_warm_body">Battery temperature is elevated. Reduce heavy workloads and charging heat; Android thermal status remains the primary throttling signal.</string>
    <string name="dashboard_rec_battery_low_title">Battery level is low</string>
    <string name="dashboard_rec_battery_low_body">Consider Battery Saver and postpone non-essential maintenance until charging, especially large scans or media processing.</string>
    <string name="dashboard_rec_network_title">Internet is not validated</string>
    <string name="dashboard_rec_network_body">Android does not currently report a validated internet connection. Network throughput can remain unavailable until connectivity is restored.</string>
    <string name="dashboard_rec_healthy_title">No urgent action recommended</string>
    <string name="dashboard_rec_healthy_body">Current memory, storage, thermal, battery, and connectivity signals do not indicate an immediate problem.</string>
    <string name="dashboard_health_timeline">Device health timeline</string>
    <string name="dashboard_health_timeline_body">Durable local history sampled in the background; no cloud upload.</string>
    <string name="dashboard_health_timeline_empty">History will populate automatically while ApexTuner is installed. Android may defer background samples to protect battery.</string>
